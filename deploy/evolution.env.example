# Salin ke deploy/evolution.env di VPS. JANGAN commit file asli ke git.
# Referensi lengkap: https://doc.evolution-api.com/

SERVER_URL=http://evolution-api:8080
AUTHENTICATION_API_KEY=CHANGE_THIS_EVOLUTION_API_KEY
DATABASE_ENABLED=true
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://evolution:CHANGE_THIS_EVOLUTION_DB_PASSWORD@evolution-db:5432/evolution
CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://evolution-redis:6379/0
