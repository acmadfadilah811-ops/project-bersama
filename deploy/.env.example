# ==============================================================================
# Salin ke deploy/.env di VPS. JANGAN PERNAH commit file .env asli ke git
# (repo GitHub project ini PUBLIC).
# ==============================================================================

# --- Compose (dipakai docker-compose.yml langsung) ---
BACKEND_REPLICAS=3
BACKUP_RCLONE_REMOTE=bintang-backup:bintang-db-backups
EVOLUTION_DB_PASSWORD=CHANGE_THIS_EVOLUTION_DB_PASSWORD

# --- Django core ---
DEBUG=False
SECRET_KEY=CHANGE_THIS_TO_LONG_RANDOM_50_CHAR_SECRET_KEY
ALLOWED_HOSTS=CHANGE_THIS_DOMAIN_ATAU_IP_VPS
NUM_PROXIES=1

# --- Database (host = nama service compose "bintang-db", BUKAN 127.0.0.1) ---
DB_ENGINE=postgres
DB_NAME=bintang
DB_USER=bintang
DB_PASSWORD=CHANGE_THIS_DB_SECURE_PASSWORD
DB_HOST=bintang-db
DB_PORT=5432

# --- Redis (host = nama service compose "bintang-redis") ---
REDIS_URL=redis://bintang-redis:6379/1

# --- CORS/CSRF — isi domain publik VPS baru (Cloudflare Tunnel URL atau domain tetap) ---
CORS_ALLOWED_ORIGINS=https://CHANGE_THIS_DOMAIN
CSRF_TRUSTED_ORIGINS=https://CHANGE_THIS_DOMAIN

# --- Evolution API (WhatsApp gateway) — host = nama service compose "evolution-api" ---
EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_API_KEY=CHANGE_THIS_EVOLUTION_API_KEY

# --- Secret lain ---
FONNTE_WEBHOOK_SECRET=CHANGE_THIS_FONNTE_SECRET
CLIENT_LOG_SECRET=CHANGE_THIS_CLIENT_LOG_SECRET
SENTRY_DSN=

# --- Email ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.mailgun.org
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=CHANGE_THIS
EMAIL_HOST_PASSWORD=CHANGE_THIS
DEFAULT_FROM_EMAIL=Bintang Advertising <noreply@example.com>
